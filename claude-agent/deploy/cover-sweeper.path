[Unit]
# 「dirty 标记」：写书/修书收尾往 pending/ 丢一个 <slug>.json，这里一看到目录非空就拉起 cover-sweeper.service。
# 没新书 = 目录为空 = 什么都不发生。服务退出后 systemd 会重查目录，所以 sweeper 必须把 pending/ 清空再退。
Description=Trigger cover sweeper when the cover queue has pending items

[Path]
DirectoryNotEmpty=/opt/claude-agent/cover-queue/pending
Unit=cover-sweeper.service

[Install]
WantedBy=multi-user.target
